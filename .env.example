# Copiare in .env (escluso da Git) e scegliere una password.
# docker compose legge .env da solo; anche servizio/db.py lo legge quando
# il servizio o i test girano fuori da Docker.
POSTGRES_PASSWORD=scegli-una-password

# Quanti brani recuperare per domanda. Facoltativo: predefinito 5.
RECUPERO_K=5

# Porta del servizio sul computer. Facoltativo: predefinita 8020 (la 8010 resta al servizio avviato fuori da Docker).
API_PORTA=8020
